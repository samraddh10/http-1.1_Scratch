{
  "name": "wirehttp",
  "version": "0.1.0",
  "private": true,
  "description": "An HTTP/1.1 server written from scratch on raw TCP sockets, running unmodified Express",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch app/server.ts",
    "start": "npm run build:frontend && tsx app/server.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.frontend.json",
    "build:frontend": "vite build",
    "bench": "node bench/autocannon.mjs"
  },
  "dependencies": {
    "express": "4.22.2"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "^22.18.12",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "autocannon": "8.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
